    {{objectName}}:
      type: object
      properties:{{#data}}
        {{lowKey}}:
          type: {{type}}{{#array}}
          items:
            type: {{typeArray}}{{/array}}{{#format}}
          format: {{format}}{{/format}}{{#pattern}}
          pattern: {{yaml pattern}}{{/pattern}}{{#enumitems}}{{#if @first}}
          enum:{{/if}}
          - {{yaml value string=asString}}{{/enumitems}}{{#minlength}}
          minLength: {{minlength}}{{/minlength}}{{#maxLength}}
          maxLength: {{maxLength}}{{/maxLength}}{{#examplevalue}}
          example: {{yaml example}}{{/examplevalue}}{{#description}}
          description: {{yaml description}}{{/description}}{{/data}}
      required:{{#data}}{{#required}}
      - {{lowKey}}{{/required}}{{/data}}